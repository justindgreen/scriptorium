# Copy to .env next to compose.yml.
APP_SECRET=replace-with-a-random-string-of-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password
PUBLIC_URL=http://localhost:3000
PORT=3000
TRUST_PROXY=false
LOG_LEVEL=info
# Cron expression for automatic backups (empty disables), e.g. "0 4 * * *" for 04:00 daily.
BACKUP_CRON=
BACKUP_RETENTION=14
