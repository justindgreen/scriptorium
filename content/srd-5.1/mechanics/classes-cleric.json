  {
    "uid": "srd-5.1:feature:divine-intervention",
    "effects": [
      {
        "type": "resource.define",
        "resource": {
          "id": "divine-intervention",
          "name": "Divine Intervention",
          "max": 1,
          "recharge": "none"
        }
      },
      {
        "type": "manual",
        "text": "Once per 7 days, roll percentile dice; on a roll at or below your cleric level your deity intervenes. Restore the use after 7 days."
      }
    ],
    "automation": {
      "level": "partial",
      "manualParts": ["the percentile check", "the seven-day recharge"]
    },
    "tests": [
      {
        "given": {
          "fixture": "cleric-20-life"
        },
        "expect": {
          "stat": "resource.divine-intervention.max",
          "equals": 1
        }
      }
    ]
  },
