[
  {
    "uid": "srd-5.1:feature:spellcasting-cleric",
    "effects": [
      {
        "type": "spellcasting.grant",
        "ability": "wis",
        "progression": "full",
        "preparation": "prepared",
        "list": "srd-5.1:spell_list:cleric",
        "ritual": true,
        "focus": "holy symbol",
        "preparedFormula": "castingMod + classLevel('srd-5.1:class:cleric')"
      }
    ],
    "automation": {
      "level": "full"
    },
    "tests": [
      {
        "given": {
          "fixture": "cleric-5-life"
        },
        "expect": {
          "stat": "spell.saveDC",
          "equals": 15
        }
      },
      {
        "given": {
          "fixture": "cleric-5-life"
        },
        "expect": {
          "stat": "spell.slots.3",
          "equals": 2
        }
      },
      {
        "given": {
          "fixture": "cleric-5-life"
        },
        "expect": {
          "stat": "spell.prepared.max",
          "equals": 9
        }
      },
      {
        "given": {
          "fixture": "cleric-20-life"
        },
        "expect": {
          "stat": "spell.slots.9",
          "equals": 1
        }
      }
    ]
  },
