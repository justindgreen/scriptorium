  {
    "uid": "srd-5.1:feature:channel-divinity-1-rest",
    "effects": [
      {
        "type": "resource.define",
        "resource": {
          "id": "channel-divinity",
          "name": "Channel Divinity",
          "max": "table('channel-divinity-charges', classLevel('srd-5.1:class:cleric'))",
          "recharge": "shortRest"
        }
      }
    ],
    "automation": {
      "level": "full"
    },
    "tests": [
      {
        "given": {
          "fixture": "cleric-5-life"
        },
        "expect": {
          "stat": "resource.channel-divinity.max",
          "equals": 1
        }
      },
      {
        "given": {
          "fixture": "cleric-20-life"
        },
        "expect": {
          "stat": "resource.channel-divinity.max",
          "equals": 3
        }
      }
    ]
  },
  {
    "uid": "srd-5.1:feature:channel-divinity-turn-undead",
    "effects": [
      {
        "type": "action.grant",
        "name": "Channel Divinity: Turn Undead",
        "actionType": "action",
        "save": {
          "ability": "wis",
          "dc": "spell",
          "onSuccess": "none"
        },
        "cost": {
          "resource": "channel-divinity",
          "amount": 1
        },
        "description": "Each undead within 30 feet that can see or hear you must succeed on a Wisdom save or be turned for 1 minute."
      },
      {
        "type": "manual",
        "text": "Apply the turned condition to each undead that fails."
      }
    ],
    "automation": {
      "level": "partial",
      "manualParts": ["applying the turned condition"]
    },
    "tests": [
      {
        "given": {
          "fixture": "cleric-5-life"
        },
        "expect": {
          "actionPlan": {
            "ref": {
              "kind": "action",
              "templateId": "action:class:srd-5.1:class:cleric@2/feature:channel-divinity-turn-undead/channel-divinity-turn-undead"
            },
            "ctx": {}
          },
          "contains": {
            "save": {
              "ability": "wis",
              "dc": 15
            },
            "costs": [
              {
                "kind": "resource",
                "id": "channel-divinity"
              }
            ]
          }
        }
      }
    ]
  },
