  {
    "uid": "srd-5.1:feature:disciple-of-life",
    "effects": [
      {
        "type": "manual",
        "text": "Healing spells of 1st level or higher restore 2 + the spell's level extra hit points."
      }
    ],
    "automation": {
      "level": "manual",
      "notes": "Healing bonuses have no effect type yet."
    }
  },
  {
    "uid": "srd-5.1:feature:channel-divinity-preserve-life",
    "effects": [
      {
        "type": "action.grant",
        "name": "Channel Divinity: Preserve Life",
        "actionType": "action",
        "healing": "5 * classLevel('srd-5.1:class:cleric')",
        "cost": {
          "resource": "channel-divinity",
          "amount": 1
        },
        "description": "Distribute hit points among creatures within 30 feet, none above half its maximum."
      },
      {
        "type": "manual",
        "text": "Distribute the healing; no creature can go above half its hit point maximum."
      }
    ],
    "automation": {
      "level": "partial",
      "manualParts": ["distributing the healing"]
    },
    "tests": [
      {
        "given": {
          "fixture": "cleric-5-life"
        },
        "expect": {
          "actionPlan": {
            "ref": {
              "kind": "action",
              "templateId": "action:subclass:srd-5.1:subclass:life@2/feature:channel-divinity-preserve-life/channel-divinity-preserve-life"
            },
            "ctx": {}
          },
          "contains": {
            "healing": "25"
          }
        }
      }
    ]
  },
  {
    "uid": "srd-5.1:feature:blessed-healer",
    "effects": [
      {
        "type": "manual",
        "text": "When you cast a healing spell of 1st level or higher on another creature, you regain 2 + the spell's level hit points."
      }
    ],
    "automation": {
      "level": "manual",
      "notes": "Healing side effects have no effect type yet."
    }
  },
  {
    "uid": "srd-5.1:feature:divine-strike",
    "effects": [
      {
        "type": "action.damageAdd",
        "formula": "1d8",
        "damageType": "radiant",
        "label": "Divine Strike",
        "oncePerTurn": "divine-strike",
        "condition": {
          "all": [
            {
              "any": [
                {
                  "leaf": "ctx.attackType",
                  "type": "melee"
                },
                {
                  "leaf": "ctx.attackType",
                  "type": "ranged"
                }
              ]
            },
            {
              "not": {
                "leaf": "classLevel",
                "class": "srd-5.1:class:cleric",
                "gte": 14
              }
            }
          ]
        }
      },
      {
        "type": "action.damageAdd",
        "formula": "2d8",
        "damageType": "radiant",
        "label": "Divine Strike",
        "oncePerTurn": "divine-strike",
        "condition": {
          "all": [
            {
              "any": [
                {
                  "leaf": "ctx.attackType",
                  "type": "melee"
                },
                {
                  "leaf": "ctx.attackType",
                  "type": "ranged"
                }
              ]
            },
            {
              "leaf": "classLevel",
              "class": "srd-5.1:class:cleric",
              "gte": 14
            }
          ]
        }
      }
    ],
    "automation": {
      "level": "full"
    },
    "tests": [
      {
        "given": {
          "fixture": "cleric-20-life"
        },
        "expect": {
          "actionPlan": {
            "ref": {
              "kind": "weapon",
              "itemId": "mace"
            },
            "ctx": {}
          },
          "contains": {
            "damage": [
              {
                "id": "divine-strike",
                "formula": "2d8",
                "damageType": "radiant"
              }
            ]
          }
        }
      },
      {
        "given": {
          "fixture": "cleric-20-life",
          "modify": {
            "definition": {
              "classes": [
                {
                  "classUid": "srd-5.1:class:cleric",
                  "subclassUid": "srd-5.1:subclass:life",
                  "level": 8,
                  "order": 0
                }
              ]
            }
          }
        },
        "expect": {
          "actionPlan": {
            "ref": {
              "kind": "weapon",
              "itemId": "mace"
            },
            "ctx": {}
          },
          "contains": {
            "damage": [
              {
                "id": "divine-strike",
                "formula": "1d8"
              }
            ]
          }
        }
      }
    ]
  },
