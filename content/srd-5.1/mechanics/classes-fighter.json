  {
    "uid": "srd-5.1:feature:fighter-fighting-style-dueling",
    "effects": [
      {
        "type": "action.damageAdd",
        "formula": "2",
        "damageType": "weapon",
        "label": "Dueling",
        "appliesTo": "melee",
        "condition": {
          "all": [
            {
              "leaf": "ctx.wieldingOneHanded"
            },
            {
              "not": {
                "leaf": "ctx.weaponProperty",
                "property": "two-handed"
              }
            }
          ]
        }
      },
      {
        "type": "manual",
        "text": "Only while you wield no other weapons."
      }
    ],
    "automation": {
      "level": "partial",
      "manualParts": ["the \"no other weapons\" check"]
    },
    "tests": [
      {
        "given": {
          "fixture": "fighter-1",
          "modify": {
            "definition": {
              "choices": {
                "class:srd-5.1:class:fighter@1/feature:fighter-fighting-style/fighting-style": {
                  "kind": "optionSet",
                  "options": ["dueling"]
                }
              }
            }
          }
        },
        "expect": {
          "actionPlan": {
            "ref": {
              "kind": "weapon",
              "itemId": "longsword"
            },
            "ctx": {}
          },
          "contains": {
            "damage": [
              {
                "id": "dueling",
                "formula": "2"
              }
            ]
          }
        }
      }
    ]
  },
