        "kind": "skill",
        "target": "stealth",
        "level": "half"
      },
      {
        "type": "bonus",
        "target": "initiative.bonus",
        "value": "floor(PB / 2)",
        "note": "Remarkable Athlete"
      },
      {
        "type": "manual",
        "text": "Running long jump distance increases by a number of feet equal to your Strength modifier."
      }
    ],
