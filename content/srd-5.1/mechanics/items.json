  {
    "uid": "srd-5.1:item:mace-of-disruption",
    "data": {
      "category": "weapon",
      "weapon": {
        "category": "simple",
        "range": "melee",
        "damage": {
          "dice": "1d6",
          "damageType": "bludgeoning"
        },
        "properties": ["magical"]
      }
    },
    "effects": [
      {
        "type": "action.damageAdd",
        "formula": "2d6",
        "damageType": "radiant",
        "label": "Disruption",
        "condition": {
          "leaf": "ctx.targetType",
          "types": ["fiend", "undead"]
        }
      },
      {
        "type": "manual",
        "text": "A fiend or undead with 25 hit points or fewer after the hit must succeed on a DC 15 Wisdom save or be destroyed; on a success it is frightened until the end of your next turn. The mace sheds bright light in a 20-foot radius."
      }
    ],
    "automation": {
      "level": "partial",
      "manualParts": ["the destroy/frighten save", "light"]
    },
    "tests": [
      {
        "given": {
          "fixture": "cleric-20-life"
        },
        "expect": {
          "actionPlan": {
            "ref": {
              "kind": "weapon",
              "itemId": "disruption"
            },
            "ctx": {
              "target": {
                "creatureType": "undead"
              }
            }
          },
          "contains": {
            "damage": [
              {
                "id": "disruption",
                "formula": "2d6",
                "damageType": "radiant"
              }
            ]
          }
        }
      },
      {
        "given": {
          "fixture": "cleric-20-life"
        },
        "expect": {
          "actionPlan": {
            "ref": {
              "kind": "weapon",
              "itemId": "disruption"
            },
            "ctx": {
              "target": {
                "creatureType": "humanoid"
              }
            }
          },
          "excludes": {
            "damageIds": ["disruption"]
          }
        }
      }
    ]
  },
  {
    "uid": "srd-5.1:item:wand-of-magic-missiles",
    "data": {
      "charges": {
        "max": 7,
        "recharge": {
          "time": "dawn",
          "formula": "1d6 + 1"
        },
        "destroyedOnLastCharge": "If you expend the last charge, roll a d20; on a 1 the wand crumbles into ashes."
      }
    },
    "effects": [
      {
        "type": "action.grant",
        "name": "Magic Missile (wand)",
        "actionType": "action",
        "damage": [
          {
            "formula": "3d4 + 3",
            "damageType": "force"
          }
        ],
        "cost": {
          "charges": 1
        },
        "description": "Cast magic missile (three darts) for 1 charge; spend more charges to cast at a higher level."
      },
      {
        "type": "manual",
        "text": "Spending extra charges adds one dart (1d4 + 1 force) per charge."
      }
    ],
    "automation": {
      "level": "partial",
      "manualParts": ["higher-level casting with more charges"]
    },
    "tests": [
      {
        "given": {
          "fixture": "cleric-20-life"
        },
        "expect": {
          "actionPlan": {
            "ref": {
              "kind": "action",
              "templateId": "action:item:wand/magic-missile-wand"
            },
            "ctx": {}
          },
          "contains": {
            "costs": [
              {
                "kind": "charges",
                "amount": 1,
                "available": 7
              }
            ],
            "damage": [
              {
                "id": "damage-0",
                "formula": "3d4 + 3",
                "damageType": "force"
              }
            ]
          }
        }
      }
    ]
  },
