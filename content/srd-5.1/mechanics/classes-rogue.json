  {
    "uid": "srd-5.1:feature:sneak-attack",
    "effects": [
      {
        "type": "action.damageAdd",
        "formula": "dice(ceil(classLevel('srd-5.1:class:rogue') / 2), 6)",
        "damageType": "weapon",
        "oncePerTurn": "sneak-attack",
        "label": "Sneak Attack",
        "condition": {
          "all": [
            {
              "any": [
                {
                  "leaf": "ctx.hasAdvantage"
                },
                {
                  "leaf": "ctx.allyAdjacent"
                }
              ]
            },
            {
              "any": [
                {
                  "leaf": "ctx.weaponProperty",
                  "property": "finesse"
                },
                {
                  "leaf": "ctx.attackType",
                  "type": "ranged"
                }
              ]
            }
          ]
        }
      }
    ],
    "automation": {
      "level": "full"
    },
    "tests": [
      {
        "given": {
          "fixture": "rogue-5-thief"
        },
        "expect": {
          "actionPlan": {
            "ref": {
              "kind": "weapon",
              "itemId": "rapier"
            },
            "ctx": {
              "situation": {
                "hidden": true
              }
            }
          },
          "contains": {
            "damage": [
              {
                "id": "sneak-attack",
                "formula": "3d6"
              }
            ],
            "oncePerTurnKeys": ["sneak-attack"]
          }
        }
      },
      {
        "given": {
          "fixture": "rogue-5-thief"
        },
        "expect": {
          "actionPlan": {
            "ref": {
              "kind": "weapon",
              "itemId": "rapier"
            },
            "ctx": {
              "situation": {
                "allyAdjacentToTarget": false
              }
            }
          },
          "excludes": {
            "damageIds": ["sneak-attack"]
          }
        }
      },
      {
        "given": {
          "fixture": "rogue-20-thief"
        },
        "expect": {
          "actionPlan": {
            "ref": {
              "kind": "weapon",
              "itemId": "rapier"
            },
            "ctx": {
              "situation": {
                "hidden": true
              }
            }
          },
          "contains": {
            "damage": [
              {
                "id": "sneak-attack",
                "formula": "10d6"
              }
            ]
          }
        }
      }
    ]
  },
