  {
    "uid": "srd-5.1:feature:rogue-evasion",
    "effects": [
      {
        "type": "manual",
        "text": "On a Dexterity save against an effect that deals half damage on a success, take no damage on a success and half on a failure."
      }
    ],
    "automation": {
      "level": "manual",
      "notes": "Depends on the save outcome, which the engine does not see."
    }
  },
  {
    "uid": "srd-5.1:feature:reliable-talent",
    "effects": [
      {
        "type": "manual",
        "text": "Treat a d20 roll of 9 or lower as a 10 on ability checks that add your proficiency bonus."
      }
    ],
    "automation": {
      "level": "manual",
      "notes": "Minimum roll rules need the roll step."
    }
  },
