  {
    "uid": "srd-5.1:feature:second-story-work",
    "effects": [
      {
        "type": "manual",
        "text": "Climbing costs no extra movement; running jumps gain your Dexterity modifier in feet."
      }
    ],
    "automation": {
      "level": "manual",
      "notes": "Movement costs are not modelled."
    }
  },
  {
    "uid": "srd-5.1:feature:supreme-sneak",
    "effects": [
      {
        "type": "advantage",
        "on": "check.stealth"
      },
      {
        "type": "manual",
        "text": "Only if you move no more than half your speed on the same turn."
      }
    ],
    "automation": {
      "level": "partial",
