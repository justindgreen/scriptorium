  "content": [
    {
      "kind": "feature",
      "uid": "srd-5.1:feature:sneak-attack",
      "slug": "sneak-attack",
      "name": "Sneak Attack",
      "data": {
        "description": "Once per turn, extra damage with a finesse or ranged weapon when you have advantage or an ally is adjacent to the target."
      },
      "effects": [
        {
          "type": "action.damageAdd",
          "formula": "dice(ceil(classLevel('srd-5.1:class:rogue') / 2), 6)",
          "damageType": "weapon",
          "oncePerTurn": "sneak-attack",
          "label": "Sneak Attack",
          "condition": {
            "all": [
              { "any": [{ "leaf": "ctx.hasAdvantage" }, { "leaf": "ctx.allyAdjacent" }] },
              {
                "any": [
                  { "leaf": "ctx.weaponProperty", "property": "finesse" },
                  { "leaf": "ctx.attackType", "type": "ranged" }
                ]
              }
            ]
          }
        }
      ],
      "automation": { "level": "full" }
    }
  ],
  "aggregate": {
    "name": "Sable",
    "definition": {
      "baseAbilities": { "str": 10, "dex": 16, "con": 12, "int": 12, "wis": 10, "cha": 14 },
      "speciesUid": "srd-5.1:species:high-elf",
      "classes": [{ "classUid": "srd-5.1:class:rogue", "level": 5, "order": 0 }],
      "choices": {
        "class:srd-5.1:class:rogue@1/skills": {
          "kind": "skill",
          "skills": ["stealth", "acrobatics", "perception", "deception"]
