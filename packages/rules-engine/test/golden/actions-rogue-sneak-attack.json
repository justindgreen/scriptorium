  "actions": [
    {
      "name": "advantage from hiding adds Sneak Attack once",
      "ref": { "kind": "weapon", "itemId": "rapier" },
      "ctx": { "situation": { "hidden": true } },
      "expectPlan": {
        "attack": { "bonus": 7, "mode": "advantage", "critRange": 20, "attackType": "melee" },
        "damageIds": ["weapon", "sneak-attack"],
        "damage": [
          {
            "id": "weapon",
            "formula": "1d8 + 4",
            "critFormula": "2d8 + 4",
            "damageType": "piercing"
          },
          {
            "id": "sneak-attack",
            "formula": "3d6",
            "critFormula": "6d6",
            "damageType": "piercing",
            "oncePerTurnKey": "sneak-attack"
          }
        ],
        "questions": [],
        "oncePerTurnKeys": ["sneak-attack"],
        "economy": { "available": true },
        "blocked": null
      },
      "rolls": { "attack": { "natural": 20 }, "damage": { "weapon": 12, "sneak-attack": 20 } },
      "targetAc": 15,
      "expectOutcome": {
        "hit": true,
        "critical": true,
        "packets": [
          { "id": "weapon", "amount": 12 },
          { "id": "sneak-attack", "amount": 20 }
        ],
        "oncePerTurnMarks": ["sneak-attack"],
        "economyMark": "action"
      }
    },
    {
      "name": "without advantage the engine asks about an adjacent ally and assumes none",
      "ref": { "kind": "weapon", "itemId": "rapier" },
      "expectPlan": {
        "attack": { "mode": "normal" },
        "damageIds": ["weapon"],
        "questions": ["allyAdjacent"],
        "assumptions": [{ "id": "allyAdjacent", "value": false }],
        "oncePerTurnKeys": []
      },
      "rolls": { "attack": { "natural": 5 }, "damage": { "weapon": 9 } },
      "targetAc": 15,
      "expectOutcome": { "hit": false, "critical": false, "packets": [], "oncePerTurnMarks": [] }
    },
    {
      "name": "answering the ally question grants Sneak Attack",
      "ref": { "kind": "weapon", "itemId": "rapier" },
      "ctx": { "options": { "answers": { "allyAdjacent": true } } },
      "expectPlan": { "damageIds": ["weapon", "sneak-attack"], "questions": [], "assumptions": [] },
      "rolls": { "attack": { "natural": 10 }, "damage": { "weapon": 9, "sneak-attack": 11 } },
      "expectOutcome": {
        "hit": null,
        "packets": [
          { "id": "weapon", "amount": 9 },
          { "id": "sneak-attack", "amount": 11 }
        ],
        "oncePerTurnMarks": ["sneak-attack"]
      }
    },
    {
      "name": "a ranged weapon qualifies too",
      "ref": { "kind": "weapon", "itemId": "bow" },
      "ctx": { "situation": { "hidden": true } },
      "expectPlan": {
        "attack": { "bonus": 7, "attackType": "ranged" },
        "damageIds": ["weapon", "sneak-attack"],
        "damage": [{ "id": "weapon", "formula": "1d6 + 4" }]
      }
    },
    {
      "name": "a non-finesse melee weapon never gets Sneak Attack",
      "ref": { "kind": "weapon", "itemId": "longsword" },
      "ctx": { "situation": { "hidden": true } },
      "expectPlan": {
        "attack": { "bonus": 3 },
        "damageIds": ["weapon"],
        "damage": [{ "id": "weapon", "formula": "1d8" }],
        "questions": []
      }
    },
    {
      "name": "a save roll uses the sheet bonus and no packets",
      "ref": { "kind": "save", "ability": "dex" },
      "expectPlan": { "damageIds": [], "costs": [] }
    }
