{
  "name": "stack-keys-and-clamps",
  "ruleset": "srd5.1-2014",
  "snapshotRefs": ["srd-5.1:class:fighter"],
  "contentFiles": ["_overlays.json"],
  "aggregate": {
    "name": "Ogrim",
    "definition": {
      "baseAbilities": { "str": 18, "dex": 10, "con": 10, "int": 8, "wis": 10, "cha": 10 },
      "classes": [{ "classUid": "srd-5.1:class:fighter", "level": 1, "order": 0 }]
    },
    "inventory": [
      {
        "id": "gauntlets",
        "itemUid": "golden:item:gauntlets-of-ogre-power",
        "quantity": 1,
        "equipped": true,
        "attuned": true
      },
      {
        "id": "headband",
        "itemUid": "golden:item:headband-of-intellect",
        "quantity": 1,
        "equipped": true,
        "attuned": true
      },
      {
        "id": "ring-a",
        "itemUid": "golden:item:ring-of-protection",
        "quantity": 1,
        "equipped": true,
        "attuned": true
      },
      {
        "id": "ring-b",
        "itemUid": "golden:item:ring-of-protection",
        "quantity": 1,
        "equipped": true,
        "attuned": true
      }
    ],
    "state": {
      "activeEffects": [
        {
          "id": "growth",
          "name": "Giant Growth",
          "effects": [{ "type": "abilityScore.bonus", "ability": "str", "value": 4 }]
        },
        {
          "id": "blessing",
          "name": "Blessing of Might",
          "effects": [{ "type": "abilityScore.maxIncrease", "ability": "str", "value": 2 }]
        }
      ]
    }
  },
  "expectSheet": {
    "ability.str.max": 22,
    "ability.str.score": 22,
    "ability.str.mod": 6,
    "ability.int.score": 19,
    "ability.int.mod": 4,
    "ac.bonus": 1,
    "ac.total": 11,
    "save.str.bonus": 9,
    "save.dex.bonus": 1
  },
  "expectBreakdown": {
    "ac.bonus": { "applied": ["Ring of Protection"], "lost": ["Ring of Protection"] }
  },
  "variants": [
    {
      "name": "the cap holds without the max increase",
      "aggregate": {
        "state": {
          "activeEffects": [
            {
              "id": "growth",
              "name": "Giant Growth",
              "effects": [{ "type": "abilityScore.bonus", "ability": "str", "value": 4 }]
            }
          ]
        }
      },
      "expectSheet": { "ability.str.max": 20, "ability.str.score": 20, "ability.str.mod": 5 }
    },
    {
      "name": "atLeast only raises; unattuned items do nothing",
      "aggregate": {
        "inventory": [
          {
            "id": "gauntlets",
            "itemUid": "golden:item:gauntlets-of-ogre-power",
            "quantity": 1,
            "equipped": true,
            "attuned": false
          },
          {
            "id": "headband",
            "itemUid": "golden:item:headband-of-intellect",
            "quantity": 1,
            "equipped": true,
            "attuned": true
          }
        ],
        "state": { "activeEffects": [] }
      },
      "expectSheet": { "ability.str.score": 18, "ability.int.score": 19, "ac.bonus": 0 }
    },
    {
      "name": "attuned gauntlets lift a weaker character to 19",
      "aggregate": {
        "definition": {
          "baseAbilities": { "str": 8, "dex": 10, "con": 10, "int": 20, "wis": 10, "cha": 10 }
        },
        "state": { "activeEffects": [] }
      },
      "expectSheet": { "ability.str.score": 19, "ability.int.score": 20 }
    }
  ]
}
