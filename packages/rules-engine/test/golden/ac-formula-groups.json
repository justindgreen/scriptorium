        "definition": {
          "choices": {
            "class:golden:class:ascetic@1/skills": {
              "kind": "skill",
              "skills": ["acrobatics", "stealth"]
            },
            "stat:ac.base": { "kind": "optionSet", "options": ["Unarmored Defense"] }
          }
        }
      },
      "expectSheet": { "ac.base": 15, "ac.total": 15 },
      "expectBreakdown": {
        "ac.base": { "applied": ["Unarmored Defense"], "lost": ["Mage Armor", "Unarmored"] }
      }
    },
    {
      "name": "armor disables Unarmored Defense and Unarmored Movement",
      "aggregate": {
        "inventory": [
          {
            "id": "leather",
            "itemUid": "srd-5.1:item:leather-armor",
            "quantity": 1,
            "equipped": true,
            "attuned": false
          }
        ],
        "state": { "activeEffects": [] }
      },
      "expectSheet": { "ac.base": 14, "ac.total": 14, "speed.walk": 30 },
      "expectBreakdown": {
        "ac.base": { "applied": ["Leather Armor"], "lost": ["Unarmored", "Unarmored Defense"] }
