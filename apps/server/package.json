{
  "name": "@scriptorium/server",
  "version": "0.0.1",
  "private": true,
  "description": "Fastify + tRPC API server, static web host and CLI",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@scriptorium/content-schema": "workspace:*",
    "@scriptorium/dice": "workspace:*",
    "@scriptorium/rules-engine": "workspace:*",
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "embedded-postgres": "17.9.0-beta.17",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "trpc-to-openapi": "^3.3.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
